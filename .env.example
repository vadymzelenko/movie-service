# --- Backend (apps/server) ---
PORT=4000
HOST=0.0.0.0
# Секрет для подписи прокси-ссылок (обязательно поменять)
PROXY_SECRET=change-me-to-a-long-random-string
# TMDB v3 API key или v4 Read Access Token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Kinopoisk Unofficial API (https://kinopoiskapiunofficial.tech) — рейтинги КП и русские рецензии
KINOPOISK_API_KEY=
# Разрешённые origin'ы фронтенда (через запятую). Пусто = любой origin в локальной сети
CORS_ORIGINS=
# Хосты, страницы которых разрешено разбирать экстрактору (через запятую)
EXTRACTOR_ALLOWED_HOSTS=

# --- Frontend (apps/web) ---
# Если не задано — берётся http://<hostname текущей страницы>:4000
NEXT_PUBLIC_API_URL=
